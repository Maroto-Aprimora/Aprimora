# Copie para .env.local e preencha. Valores em Supabase → Project Settings → API.
# Ambas são públicas por natureza (vão para o navegador); a segurança vem das regras RLS do banco.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública do portal (usada nos links de e-mail). Em produção, o domínio da Vercel ou o domínio próprio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (notificações no celular). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Mesmo valor de push_segredo em privado.config no banco
PUSH_SEGREDO=
