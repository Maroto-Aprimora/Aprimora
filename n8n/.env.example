# Copie para n8n/.env no VPS (NUNCA envie o .env para o GitHub).
N8N_VERSAO=stable
# Endereço do n8n (nome da VPS ou subdomínio próprio apontando para o IP)
N8N_DOMINIO=srv2043014.hstgr.cloud
# Gere uma vez e guarde em lugar seguro: openssl rand -hex 32  (perdeu = perde as credenciais salvas)
N8N_ENCRYPTION_KEY=

# Portal Aprimora
PORTAL_URL=https://aprimora.vercel.app
# Mesmo valor da variável N8N_SEGREDO na Vercel. Gere com: openssl rand -hex 32
PORTAL_N8N_SEGREDO=

# Google AI Studio (gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.8-flash

# Apollo.io (Settings → Integrations → API, chave "master"). Opcional: sem ela o Enriquecedor pula o Apollo.
# A busca de decisores não gasta crédito; revelar o e-mail do decisor gasta (sem crédito, segue sem ele).
APOLLO_API_KEY=

# ID da pasta "Aprimora – Ligações" no Google Drive (o trecho da URL depois de /folders/)
DRIVE_PASTA_LIGACOES=
