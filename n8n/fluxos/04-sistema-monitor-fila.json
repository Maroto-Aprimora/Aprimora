{
  "name": "APRIMORA | Sistema | Monitor da fila",
  "nodes": [
    {
      "id": "332ee3d3-3c3c-5019-a732-de42219c8bb5",
      "name": "Nota 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -300
      ],
      "parameters": {
        "content": "## APRIMORA | Sistema | Monitor da fila\nDe hora em hora (7h–21h) consulta a saúde da fila no portal. Se houver **mais de 30 trabalhos esperando**, a mais antiga esperando **há mais de 3 h**, ou **mais de 5 erros nas últimas 24 h**, o portal avisa os diretores pelo sino e por push. Sinal de que o n8n parou ou o Gemini está limitando.",
        "width": 600,
        "height": 180,
        "color": 4
      }
    },
    {
      "id": "f4994000-39d0-505d-96da-00806087a1e5",
      "name": "De hora em hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "5 7-21 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "5a248bbe-5447-56c5-b114-4408a96a2132",
      "name": "Consultar saúde da fila",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.PORTAL_URL }}/api/n8n/saude",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-segredo",
              "value": "={{ $env.PORTAL_N8N_SEGREDO }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "3e5e9e80-7bf6-5f01-968a-b3cb87f73cd7",
      "name": "Fila acumulada ou com erros?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "968374fd-1397-5d10-8390-8b920a31a66a",
              "leftValue": "={{ $json.pendentes }}",
              "rightValue": 30,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "445052d4-6b08-5864-a7c9-25e817e004e3",
              "leftValue": "={{ $json.mais_antiga_minutos }}",
              "rightValue": 180,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "bc202735-cb7e-5f7d-9f8c-f2ea7f015236",
              "leftValue": "={{ $json.erros_24h }}",
              "rightValue": 5,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    },
    {
      "id": "d2a1c938-4b4d-52e1-859a-1d6380da0f7c",
      "name": "Avisar diretores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PORTAL_URL }}/api/n8n/alerta",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-segredo",
              "value": "={{ $env.PORTAL_N8N_SEGREDO }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tipo: 'fila', detalhes: $json }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "De hora em hora": {
      "main": [
        [
          {
            "node": "Consultar saúde da fila",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar saúde da fila": {
      "main": [
        [
          {
            "node": "Fila acumulada ou com erros?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fila acumulada ou com erros?": {
      "main": [
        [
          {
            "node": "Avisar diretores",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": false,
    "callerPolicy": "workflowsFromSameOwner",
    "timezone": "America/Sao_Paulo",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "pinData": {},
  "active": false,
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
