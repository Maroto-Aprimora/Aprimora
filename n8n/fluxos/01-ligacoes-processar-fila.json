    {
      "id": "7f352943-5a64-5b86-af88-cc855020b824",
      "name": "Preparar áudio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Mantém o arquivo (para o Drive) e cria a versão em base64 (para o Gemini).\nconst ligacao = $('Uma por vez').item.json;\nconst binario = $input.item.binary.audio;\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'audio');\nif (buffer.length > 18 * 1024 * 1024) {\n  throw new Error(`Gravação de ${(buffer.length / 1024 / 1024).toFixed(1)} MB passa do limite de envio direto ao Gemini (18 MB).`);\n}\nbinario.fileName = ligacao.nome_arquivo;\nreturn {\n  json: { audio_base64: buffer.toString('base64'), mime: binario.mimeType || 'audio/mpeg' },\n  binary: { audio: binario },\n};"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "3e029ebd-fd47-5f3e-add5-1a097868f4a8",
      "name": "Salvar no Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        2200,
        100
      ],
      "parameters": {
        "name": "={{ $('Uma por vez').item.json.nome_arquivo }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Pasta definida').item.json.pasta_id }}"
        },
        "inputDataFieldName": "audio",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "6a939755-9a37-5120-b4ee-f143346e2bf7",
      "name": "Montar pedido ao Gemini",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        100
      ],
      "parameters": {
        "jsCode": "// Pede transcrição + avaliação em JSON, com os critérios definidos pelo diretor no portal.\nconst l = $('Uma por vez').item.json;\nconst audio = $('Preparar áudio').item.json;\nconst criterios = (l.criterios || []).map((c, i) => `${i + 1}. ${c}`).join('\\n');\nconst prompt = `Você é um avaliador de ligações comerciais da Aprimora, Empresa Júnior de Engenharia de Produção da UTFPR Londrina.\nTranscreva a ligação em português, identificando as falas como \"Assessor\" e \"Cliente\", e avalie o assessor.\n\nContexto:\n- Empresa (lead): ${l.empresa}\n- Assessor: ${l.membro}\n- Fase do funil: ${l.fase}\n- Objetivo da ligação: ${l.objetivo || 'qualificar o lead e marcar um diagnóstico'}\n\nCritérios de avaliação (nota de 0 a 10 em cada um):\n${criterios}\n\nSeja específico e construtivo: cite trechos da conversa. A nota geral é de 0 a 10.`;\nconst schema = {\n  type: 'OBJECT',\n  properties: {\n    transcricao: { type: 'STRING' },\n    resumo: { type: 'STRING' },\n    nota: { type: 'NUMBER' },\n    criterios: { type: 'ARRAY', items: { type: 'OBJECT', properties: {\n      criterio: { type: 'STRING' }, nota: { type: 'NUMBER' }, comentario: { type: 'STRING' } },\n      required: ['criterio', 'nota', 'comentario'] } },\n    pontos_fortes: { type: 'ARRAY', items: { type: 'STRING' } },\n    melhorias: { type: 'ARRAY', items: { type: 'STRING' } },\n    objecoes: { type: 'ARRAY', items: { type: 'STRING' } },\n    falou_com_decisor: { type: 'BOOLEAN' },\n    interesse_cliente: { type: 'STRING', enum: ['alto', 'medio', 'baixo', 'nenhum'] },\n    proximo_passo: { type: 'STRING' },\n  },\n  required: ['transcricao', 'resumo', 'nota', 'criterios', 'pontos_fortes', 'melhorias', 'falou_com_decisor', 'interesse_cliente', 'proximo_passo'],\n};\nreturn [{ json: { pedido: {\n  contents: [{ role: 'user', parts: [{ text: prompt }, { inline_data: { mime_type: audio.mime, data: audio.audio_base64 } }] }],\n  generationConfig: { temperature: 0.2, maxOutputTokens: 16000, responseMimeType: 'application/json', responseSchema: schema },\n} } }];"
      }
    },
    {
      "id": "4f9b46cc-e70f-5a9f-9cdc-e1b5b55f16a3",
      "name": "Transcrever e avaliar (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $env.GEMINI_MODELO }}:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.pedido) }}",
        "options": {
          "timeout": 300000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "9ca1a025-1868-55a8-9b84-4b3ad61ff1ea",
      "name": "Ler avaliação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        100
      ],
      "parameters": {
        "jsCode": "const r = $json;\nconst texto = r.candidates?.[0]?.content?.parts?.map((p) => p.text || '').join('') || '';\nlet avaliacao;\ntry { avaliacao = JSON.parse(texto); } catch (e) { throw new Error('O Gemini não devolveu um JSON válido: ' + texto.slice(0, 300)); }\nconst arquivo = $('Salvar no Google Drive').item.json;\nreturn [{ json: {\n  drive_arquivo_id: arquivo.id,\n  drive_link: `https://drive.google.com/file/d/${arquivo.id}/view`,\n  modelo: r.modelVersion || $env.GEMINI_MODELO,\n  tokens: r.usageMetadata?.totalTokenCount ?? null,\n  ...avaliacao,\n} }];"
      }
    },
