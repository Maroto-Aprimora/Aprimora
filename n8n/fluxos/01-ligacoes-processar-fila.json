    {
      "id": "254c8714-38b3-5afe-8f69-b1f5caf6b54a",
      "name": "Baixar gravação",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        100
      ],
      "parameters": {
        "url": "={{ $('Uma por vez').item.json.gravacao_url }}",
        "options": {
          "timeout": 120000,
          "response": {
